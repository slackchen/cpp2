// native_demo.cpp2 — 原生后端 v0 子集演示(--backend=native):
// 整数函数 / 递归 / 控制流。子集外构造会自动回退转译路径。
// 运行时输出经 tools/native_rt.c 的 print_int(libc printf)。
module native_demo;
import std;

print_int: (v: int) = {                 // 自含定义:两后端均可直连;原生经汇编直译,headers 经 C++ 转译
    std::println("{0}", v);
}

fib: (n: int) -> int = {
    if n < 2 { return n; }
    return fib(n - 1) + fib(n - 2);
}

sum_to: (n: int) -> int = {
    s: int = 0;
    for i in 0..=n {
        s += i;
    }
    return s;
}

main: () -> int = {
    print_int(fib(10));                 // 55
    print_int(sum_to(100));             // 5050
    return 0;
}
