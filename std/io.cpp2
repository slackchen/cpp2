// std/io.cpp2 — cpp2 标准库 io（print/println），native/headers 共用
module io;

cxx_legacy {
    #include <cstdio>
    namespace cpp2mod::io {
        int printf_wrapper(const char* s) { return ::printf("%s", s); }
        int printf_nl_wrapper(const char* s) { return ::printf("%s\n", s); }
        int printf_int_wrapper(const char* fmt, int a0) { return ::printf(fmt, a0); }
    }
}
export printf_wrapper: (s: const char*) -> int;
export printf_nl_wrapper: (s: const char*) -> int;
export printf_int_wrapper: (fmt: const char*, a0: int) -> int;

export print: (s: const char*) -> void = {
    printf_wrapper(s);
}

export println: (s: const char*) -> void = {
    printf_nl_wrapper(s);
}

export print_int: (fmt: std::string, a0: int) -> void = {
    // fmt 中 {0} -> %d
    cfmt: std::string = "";
    i: int = 0;
    n: int = fmt.size() as int;
    while i < n {
        if i + 2 < n && fmt[i] == '{' && fmt[i+1] == '0' && fmt[i+2] == '}' {
            cfmt += "%d";
            i += 3;
        } else {
            cfmt += fmt[i];
            i += 1;
        }
    }
    printf_int_wrapper(cfmt.c_str(), a0);
}
