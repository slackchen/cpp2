// std/io.cpp2 — cpp2 标准库 io（print/println），native/headers 共用
module io;

cxx_legacy {
    #include <cstdio>
    namespace cpp2mod::io {
        int printf_wrapper(const char* s) { return ::printf("%s", s); }
        int printf_nl_wrapper(const char* s) { return ::printf("%s\n", s); }
    }
}
export printf_wrapper: (s: const char*) -> int;
export printf_nl_wrapper: (s: const char*) -> int;

export print: (s: const char*) -> void = {
    printf_wrapper(s);
}

export println: (s: const char*) -> void = {
    printf_nl_wrapper(s);
}
